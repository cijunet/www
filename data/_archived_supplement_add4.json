      "作品": "过香积寺",
      "年代国别": "唐",
      "场景id": "simiao",
      "心情id": "pingjing,xinshang",
      "怎么用": "写寻寺入山的幽深。",
      "白话": "不知香积寺，数里已入云峰。"
    },
    {
