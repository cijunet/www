      "作者": "王维",
      "作品": "过香积寺",
      "年代国别": "唐",
      "场景id": "simiao",
      "心情id": "pingjing,chaoran",
      "怎么用": "写潭边安禅、心定。",
      "白话": "暮色空潭边，安禅降伏心龙。"
    },
    {
