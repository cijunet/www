  "pieces": [
    {
      "正文": "燕子来时新社，梨花落后清明。",
      "作者": "晏殊",
      "作品": "破阵子",
      "年代国别": "宋",
      "场景id": "qingming",
      "心情id": "chensi,wennuan",
      "怎么用": "写清明前后、春社梨花。",
      "白话": "燕子来时过春社，梨花落后是清明。"
    },
    {
      "正文": "雷惊天地龙蛇蛰，雨足郊原草木柔。",
      "作者": "黄庭坚",
      "作品": "清明",
      "年代国别": "宋",
      "场景id": "qingming",
      "心情id": "chensi,pingjing",
      "怎么用": "写清明雷动、草木回春。",
      "白话": "雷惊龙蛇醒，雨足草木柔。"
    },
    {
      "正文": "九日龙山饮，黄花笑逐臣。",
      "作者": "李白",
      "作品": "九日龙山饮",
      "年代国别": "唐",
      "场景id": "chongyang",
      "心情id": "kuangxi,wennuan",
      "怎么用": "重阳登高饮酒、笑对秋风。",
      "白话": "重阳龙山饮，黄花笑逐臣。"
    },
    {
      "正文": "他乡共酌金花酒，万里同悲鸿雁天。",
      "作者": "卢照邻",
      "作品": "九月九日玄武山旅眺",
      "年代国别": "唐",
      "场景id": "chongyang",
      "心情id": "sinian,gudu",
      "怎么用": "异乡重阳、同悲望雁。",
      "白话": "他乡共饮菊花酒，万里同悲雁飞天。"
    },
    {
      "正文": "醉看风落帽，舞爱月留人。",
      "作者": "李白",
      "作品": "九日",
      "年代国别": "唐",
      "场景id": "chongyang",
      "心情id": "kuangxi,wennuan",
      "怎么用": "重阳醉舞、月下尽兴。",
      "白话": "醉看风吹落帽，爱月留人不去。"
    },
    {
      "正文": "茶，香叶，嫩芽。",
      "作者": "元稹",
      "作品": "茶",
      "年代国别": "唐",
      "场景id": "chayan",
      "心情id": "xinshang,wennuan",
      "怎么用": "极简一句写茶之味。",
      "白话": "茶，是香叶，是嫩芽。"
    },
    {
      "正文": "夜臼和烟捣，寒炉对雪烹。",
      "作者": "郑遨",
      "作品": "茶诗",
      "年代国别": "唐",
      "场景id": "chayan",
      "心情id": "pingjing,xinshang",
      "怎么用": "雪夜煮茶的清趣。",
      "白话": "夜里臼中捣茶带烟，寒炉对雪来煮。"
    },
    {
      "正文": "琴里知闻唯渌水，茶中故旧是蒙山。",
      "作者": "白居易",
      "作品": "琴茶",
      "年代国别": "唐",
      "场景id": "chayan",
      "心情id": "wennuan,xinshang",
      "怎么用": "琴与茶、老友般相守。",
      "白话": "琴里知音唯渌水，茶中故旧是蒙山。"
    },
    {
      "正文": "一竿风月，一蓑烟雨，家在钓台西住。",
      "作者": "陆游",
      "作品": "鹊桥仙",
      "年代国别": "宋",
      "场景id": "chuidiao",
      "心情id": "gudu,pingjing",
      "怎么用": "写一竿烟雨的钓隐生活。",
      "白话": "一竿风月，一蓑烟雨，家住钓台西。"
    },
    {
      "正文": "钓罢归来不系船，江村月落正堪眠。",
      "作者": "司空曙",
      "作品": "江村即事",
      "年代国别": "唐",
      "场景id": "chuidiao",
      "心情id": "pingjing,wennuan",
      "怎么用": "钓罢不系船、随月而眠。",
      "白话": "钓完不系船，月落江村正好眠。"
    },
    {
      "正文": "客从远方来，遗我双鲤鱼。呼儿烹鲤鱼，中有尺素书。",
      "作者": "汉乐府",
      "作品": "饮马长城窟行",
      "年代国别": "汉",
      "场景id": "shuxin",
      "心情id": "sinian,wennuan",
      "怎么用": "收到远方来信的欢喜。",
      "白话": "客人远方来，赠我双鲤鱼；剖开得尺素书信。"
    },
    {
      "正文": "一行书信千行泪，寒到君边衣到无。",
      "作者": "陈玉兰",
      "作品": "寄夫",
      "年代国别": "唐",
      "场景id": "shuxin",
      "心情id": "sinian,beiliang",
      "怎么用": "寄冬衣附信、问寒问暖。",
      "白话": "一行信千行泪，天寒你的冬衣到了没。"
    },
    {
      "正文": "凭君莫射南来雁，恐有家书寄远人。",
      "作者": "杜牧",
      "作品": "赠猎骑",
      "年代国别": "唐",
      "场景id": "shuxin",
      "心情id": "sinian,wennuan",
      "怎么用": "托人莫射归雁、恐带家书。",
      "白话": "请你别射南来雁，怕它带着远人的家书。"
    },
    {
      "正文": "故欹单枕梦中寻，梦又不成灯又烬。",
      "作者": "欧阳修",
      "作品": "玉楼春",
      "年代国别": "宋",
      "场景id": "meng",
      "心情id": "sinian,gudu",
      "怎么用": "想入梦寻人、梦不成。",
      "白话": "斜倚孤枕梦中寻，梦不成灯又灭。"
    },
    {
      "正文": "夜深忽梦少年事，梦啼妆泪红阑干。",
