  "pieces": [
    {
      "正文": "明月几时有？把酒问青天。",
      "作者": "苏轼",
      "作品": "水调歌头",
      "年代国别": "宋",
      "场景id": "zhongqiu",
      "心情id": "chensi,wennuan",
      "怎么用": "中秋发图、对月独酌时配文。",
      "白话": "明月几时才有？我端着酒问青天。"
    },
    {
      "正文": "人有悲欢离合，月有阴晴圆缺，此事古难全。",
      "作者": "苏轼",
      "作品": "水调歌头",
      "年代国别": "宋",
      "场景id": "zhongqiu",
      "心情id": "chensi,shiran",
      "怎么用": "表达聚散无常、彼此珍重。",
      "白话": "人有离合，月有无缺，自古难两全。"
    },
    {
      "正文": "今夜月明人尽望，不知秋思落谁家。",
      "作者": "王建",
      "作品": "十五夜望月",
      "年代国别": "唐",
      "场景id": "zhongqiu",
      "心情id": "sinian,chensi",
      "怎么用": "月圆夜的淡淡思念。",
      "白话": "今夜人人望月，不知秋思落在谁家。"
    },
    {
      "正文": "中庭地白树栖鸦，冷露无声湿桂花。",
      "作者": "王建",
      "作品": "十五夜望月",
      "年代国别": "唐",
      "场景id": "zhongqiu",
      "心情id": "chensi,wennuan",
      "怎么用": "拍月下庭院的静谧感。",
      "白话": "庭院月光如霜，鸦栖树上，露湿桂花。"
    },
    {
      "正文": "此生此夜不长好，明月明年何处看。",
      "作者": "苏轼",
      "作品": "阳关曲·中秋月",
      "年代国别": "宋",
      "场景id": "zhongqiu",
      "心情id": "chensi,zhenxi",
      "怎么用": "感慨相聚短暂、明年难料。",
      "白话": "这样的月夜不长有，明年又在何处看月。"
    },
    {
      "正文": "一轮秋影转金波，飞镜又重磨。",
      "作者": "辛弃疾",
      "作品": "太常引",
      "年代国别": "宋",
      "场景id": "zhongqiu",
      "心情id": "xinshang,wennuan",
      "怎么用": "写满月如镜、秋夜清亮。",
      "白话": "一轮秋月转着金波，像刚磨过的镜子。"
    },
    {
      "正文": "西北望乡何处是，东南见月几回圆。",
      "作者": "白居易",
      "作品": "八月十五日夜湓亭望月",
      "年代国别": "唐",
      "场景id": "zhongqiu",
